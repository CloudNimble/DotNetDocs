<Project>

    <!--
        RWM: The documentation file is named after the assembly, and AssemblyName isn't set yet when Directory.Build.props is evaluated.
        MSBuild imports this file after the SDK and the project file have set AssemblyName and TargetFramework, so it belongs here.

        Applies to production packages, projects included by reference in those packages (IsPrimaryProject),
        and any other project that opted into GenerateDocumentationFile (e.g. the Tests.Shared fixture).
    -->
    <PropertyGroup Condition=" ($(IsPrimaryProject) == 'true' and '$(IsTemplateProject)' != 'true') or '$(GenerateDocumentationFile)' == 'true' ">
        <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    </PropertyGroup>

</Project>

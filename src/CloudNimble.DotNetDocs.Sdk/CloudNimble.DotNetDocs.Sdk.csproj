<Project Sdk="Microsoft.Build.NoTargets/3.7.134">

    <PropertyGroup>
        <!-- SDK packages don't compile code -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <Description>The MSBuild SDK for documentation projects (.docsproj) that provides a clean way to include documentation in .NET solutions.</Description>

        <!-- This is an MSBuild SDK package -->
        <DevelopmentDependency>true</DevelopmentDependency>
        <PackageType>MSBuildSdk</PackageType>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Suppress warnings about SDK packages -->
        <NoWarn>$(NoWarn);NU5128;CS2008;NU1701;NU5100</NoWarn>
        
        <!-- Don't create symbols package for SDK projects -->
        <IncludeSymbols>false</IncludeSymbols>
        
        <!-- Suppress dependencies when packing - NoTargets is bundled, not a runtime dependency -->
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

        <!-- Use TargetsForTfmSpecificContentInPackage to add NoTargets files and task assemblies at the right time: Pack runs
             these targets while it collects the package's files, before the .nupkg is written. -->
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeNoTargetsInPackage;IncludeTaskAssembliesInPackage</TargetsForTfmSpecificContentInPackage>

        <!-- The task assemblies come from the Sdk.Tasks build output, one folder per framework. -->
        <DotNetDocsTasksProject>$(MSBuildThisFileDirectory)..\CloudNimble.DotNetDocs.Sdk.Tasks\CloudNimble.DotNetDocs.Sdk.Tasks.csproj</DotNetDocsTasksProject>
        <DotNetDocsTasksOutputPath>$(MSBuildThisFileDirectory)..\CloudNimble.DotNetDocs.Sdk.Tasks\bin\$(Configuration)\</DotNetDocsTasksOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <!-- Reference Microsoft.Build.NoTargets to bundle its SDK files into our package -->
        <PackageReference Include="Microsoft.Build.NoTargets"
                          Version="3.7.134"
                          PrivateAssets="all"
                          GeneratePathProperty="true" />
    </ItemGroup>

    <ItemGroup>
        <!-- The frameworks the task assemblies are built for. Each one becomes a tasks\<framework> folder in the package. -->
        <DotNetDocsTaskFramework Include="net10.0;net11.0;net472" />
    </ItemGroup>

    <ItemGroup>
        <!-- Pack the SDK files -->
        <None Include="Sdk\**" Pack="true" PackagePath="Sdk" />
        <None Include="build\**" Pack="true" PackagePath="build" />
    </ItemGroup>

    <!--
        Build the task assemblies and add them to the package while Pack collects its files.
        Pack runs its dependencies, including the step that writes the .nupkg, before any BeforeTargets="Pack" target, so building
        the tasks there packed the previous build. Wildcards in a project-level item are also expanded when the project loads,
        before anything is built, so a framework with no build output yet was left out of the package. Both happen here instead,
        in that order. When NoBuild is set, as the no-build option of dotnet pack does, the existing build output is packed.
    -->
    <Target Name="IncludeTaskAssembliesInPackage">
        <MSBuild Projects="$(DotNetDocsTasksProject)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)"
                 Condition="'$(NoBuild)' != 'true'" />
        <Message Text="Built CloudNimble.DotNetDocs.Sdk.Tasks" Importance="high" Condition="'$(NoBuild)' != 'true'" />
        <Message Text="Using pre-built task assemblies from bin folder (NoBuild=true)" Importance="high" Condition="'$(NoBuild)' == 'true'" />

        <Error Text="The CloudNimble.DotNetDocs.Sdk.Tasks build output for %(DotNetDocsTaskFramework.Identity) wasn't found in $(DotNetDocsTasksOutputPath). Build the Tasks project before packing the SDK with --no-build."
               Condition="!Exists('$(DotNetDocsTasksOutputPath)%(DotNetDocsTaskFramework.Identity)\CloudNimble.DotNetDocs.Sdk.Tasks.dll')" />

        <ItemGroup>
            <DotNetDocsTaskAssembly Include="$(DotNetDocsTasksOutputPath)%(DotNetDocsTaskFramework.Identity)\*.dll">
                <TaskFramework>%(DotNetDocsTaskFramework.Identity)</TaskFramework>
            </DotNetDocsTaskAssembly>
            <TfmSpecificPackageFile Include="@(DotNetDocsTaskAssembly)">
                <PackagePath>tasks\%(DotNetDocsTaskAssembly.TaskFramework)\%(DotNetDocsTaskAssembly.Filename)%(DotNetDocsTaskAssembly.Extension)</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

    <!-- Automatically push SDK package to local feed after pack -->
    <Target Name="PushToLocalFeed" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'Debug'">
        <PropertyGroup>
            <!-- Use LOCAL_NUGET_FEED env var if set, otherwise use default local path -->
            <LocalFeedPath Condition="'$(LOCAL_NUGET_FEED)' != ''">$([System.IO.Path]::GetFullPath('$(LOCAL_NUGET_FEED)'))</LocalFeedPath>
            <LocalFeedPath Condition="'$(LOCAL_NUGET_FEED)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\local-nuget-feed'))</LocalFeedPath>
            <PackageOutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(PackageId).$(PackageVersion).nupkg</PackageOutputPath>
        </PropertyGroup>
        
        <!-- Create local feed directory if it doesn't exist -->
        <MakeDir Directories="$(LocalFeedPath)" />
        
        <!-- Push the package to local feed -->
        <Exec Command="dotnet nuget push &quot;$(PackageOutputPath)&quot; --source &quot;$(LocalFeedPath)&quot; --skip-duplicate"
              ContinueOnError="true"
              ConsoleToMSBuild="true">
            <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
        </Exec>
        
        <Message Text="📦 Pushed $(PackageId).$(PackageVersion) to local feed at $(LocalFeedPath)" Importance="high" Condition="'$(ErrorCode)' == '0'" />
        <Message Text="⚠️ Package already exists in local feed or push failed (this is OK for local development)" Importance="normal" Condition="'$(ErrorCode)' != '0'" />
    </Target>

    <!-- Bundle NoTargets SDK files into our package so consumers don't need SDK resolution -->
    <Target Name="IncludeNoTargetsInPackage">
        <PropertyGroup>
            <NoTargetsSourcePath>$(PkgMicrosoft_Build_NoTargets)\Sdk</NoTargetsSourcePath>
        </PropertyGroup>

        <ItemGroup>
            <NoTargetsFiles Include="$(NoTargetsSourcePath)\**\*" />
            <TfmSpecificPackageFile Include="@(NoTargetsFiles)">
                <PackagePath>Sdk\NoTargets\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>

        <Message Text="Bundling NoTargets SDK files from $(NoTargetsSourcePath)" Importance="high" />
    </Target>

</Project>
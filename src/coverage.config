<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings for Microsoft.Testing.Extensions.CodeCoverage, passed to every test project by Directory.Build.props.
  Format: https://github.com/microsoft/codecoverage/blob/main/docs/configuration.md
-->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Exclude>
        <!-- Test projects and shared test fixtures such as CloudNimble.DotNetDocs.Tests.Shared. This matches the file name only,
             because every module, including the product assemblies, loads from a test project's bin folder. -->
        <ModulePath>.*[\\/][^\\/]*\.Tests\.[^\\/]*$</ModulePath>
      </Exclude>
    </ModulePaths>
    <Sources>
      <Exclude>
        <!-- Source-generated code, such as the Regex generator output under obj. -->
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
    <Functions>
      <Exclude>
        <Function>.*\.Program\..*</Function>
      </Exclude>
    </Functions>
  </CodeCoverage>
</Configuration>

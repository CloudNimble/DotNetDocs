<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>DotNetDocs</PackageId>
        <PackAsTool>True</PackAsTool>
        <ToolCommandName>dotnet-docs</ToolCommandName>
        <OutputType>Exe</OutputType>
        <Description>The command-line tool that helps you manage your .NET Documentation Projects (.docsproj) and generate beautiful documentation from your XML Doc Comments.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Pastel" Version="8.*" />
        <PackageReference Include="McMaster.Extensions.Hosting.CommandLine" Version="5.*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
    </ItemGroup>

    <ItemGroup>
       <ProjectReference Include="..\CloudNimble.DotNetDocs.Core\CloudNimble.DotNetDocs.Core.csproj" />
       <ProjectReference Include="..\CloudNimble.DotNetDocs.Mintlify\CloudNimble.DotNetDocs.Mintlify.csproj" />
     </ItemGroup>

</Project>
